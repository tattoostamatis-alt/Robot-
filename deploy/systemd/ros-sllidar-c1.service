[Unit]
Description=ROS 2 Slamtec SLLIDAR C1
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dimi
Group=dimi
Environment=HOME=/home/dimi
Environment=ROS_DOMAIN_ID=0
ExecStart=/home/dimi/bin/start_sllidar_c1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
