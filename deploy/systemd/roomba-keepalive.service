[Unit]
# Wakes the Roomba when this PC comes up, then holds it in OI Full mode, which
# has no inactivity sleep timer, so the robot stays awake for as long as the PC
# is on. Trade-off (user-accepted): Full mode does not charge on the dock, so
# the battery slowly drains while idle.
#
# Unlike the other robot services (moved off boot to on-demand), this one is
# deliberately always-on: it is idle for ~29 of every 30 seconds, and its whole
# purpose is to cover the stretches when nothing else is running.
#
# The robot is on a USB serial adapter, so dev-roomba.device only appears once
# udev has processed it. After= alone would let us start before the port exists
# and burn the whole boot-time wake burst on ENOENT; BindsTo= additionally stops
# us if the adapter is unplugged, and systemd restarts us when it comes back --
# which re-runs the wake burst, exactly what a just-replugged robot needs.
Description=Roomba wake + keep-alive (hold Full mode, never sleep)
After=dev-roomba.device
BindsTo=dev-roomba.device

[Service]
Type=simple
User=dimi
# NO `Group=dialout` here. Setting Group= makes systemd use it as the primary
# group and drop the user's supplementary groups -- and dimi is already in
# dialout, so it bought nothing while breaking the stand-down check: `fuser`
# could no longer read the file descriptors of roomba_driver (which runs as
# dimi:dimi), always reported the port free, and the daemon happily opened it
# alongside the running ROS driver. Two owners on one serial line is exactly
# the framing corruption this is supposed to avoid. Found 2026-07-25.
Environment=HOME=/home/dimi
# For the notify-send popup when the robot needs a CLEAN press. Harmless when
# no desktop session is logged in -- notify() is best-effort.
Environment=DISPLAY=:0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/usr/bin/python3 /home/dimi/robot_ws/src/home_robot/scripts/roomba_keepalive.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
