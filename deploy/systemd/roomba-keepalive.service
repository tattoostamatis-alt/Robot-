[Unit]
# Holds the Roomba in OI Full mode, which has no 5-minute inactivity sleep, so
# the robot never sleeps. A BRC-pulse keep-alive was tried first but this
# robot/cable ignores the RTS/DTR wake, so once asleep only a CLEAN press wakes
# it -- Full mode avoids ever getting there. Trade-off (user-accepted): Full
# mode does not charge on the dock, so the battery slowly drains while idle.
#
# Unlike the other robot services (moved off boot to on-demand), this one is
# deliberately always-on: it is idle for ~59 of every 60 seconds, and its whole
# purpose is to cover the stretches when nothing else is running.
Description=Roomba keep-alive (hold Full mode, never sleep)
After=dev-roomba.device
Wants=dev-roomba.device

[Service]
Type=simple
User=dimi
Group=dialout
Environment=HOME=/home/dimi
ExecStart=/usr/bin/python3 /home/dimi/robot_ws/src/home_robot/scripts/roomba_keepalive.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
