# SLAMTEC C1 LiDAR (Silicon Labs CP2102N). Matched by serial because the
# RoArm-M3 below is ALSO a CP2102N (10c4:ea60) — without the serial the two
# collide and either device could grab the "lidar" symlink at boot.
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="2e1319083b70f011988594301045c30f", SYMLINK+="lidar", MODE="0666"

# iRobot Roomba (FTDI FT232R)
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", SYMLINK+="roomba", MODE="0666"

# ESP32 + BNO085 IMU (CH340 USB-serial). CH340 clones don't report a usable
# per-device serial, so this used to be pinned to a physical USB port path
# (KERNELS==) — but that path is not stable across reboots/replugs and kept
# breaking (5-1.2 → 3-4 on 2026-06-18 → 1-1.1 on 2026-06-25 → 5-1.4 on
# 2026-07-21), each time silently leaving no /dev/imu at all. The RoArm-M3
# turned out to be a CP2102N, not a CH340, so this is the ONLY 1a86:7523 on
# the machine and VID:PID alone is unambiguous.
# If a second CH340 device is ever added, re-add a KERNELS== port match here.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="imu", MODE="0666"

# Waveshare RoArm-M3 (ESP32 driver board with a Silicon Labs CP2102N, NOT the
# CH340 the earlier note guessed). Connected 2026-07-01. Same 10c4:ea60 as the
# lidar, so it MUST be matched by its unique serial to avoid stealing the
# lidar symlink.
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="54ecc5ecfc73ef11bcebcd8c8fcc3fa0", SYMLINK+="arm", MODE="0666"
